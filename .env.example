# =============================================================================
# KubeCommerce - example environment for LOCAL DEVELOPMENT ONLY.
#
#   * This file contains NO real secrets. Every value is a local placeholder.
#   * The real `.env` file is git-ignored and MUST NOT be committed.
#   * Generate local JWT keys with:  bash scripts/dev-bootstrap.sh
#     which creates `.secrets/jwt-private.pem` and `.secrets/jwt-public.pem`.
#     For any non-local environment use a secret manager (AWS Secrets Manager +
#     External Secrets Operator) - never this file.
#
# Convention: the environment variable name matches the corresponding
# settings field name in `libs/observability` (UPPERCASE(field)).
# Copy with:  cp .env.example .env   (or run scripts/dev-bootstrap.sh)
# =============================================================================

# -----------------------------------------------------------------------------
# Shared (all services)
# -----------------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
SERVICE_VERSION=0.1.0
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SAMPLE_RATIO=1.0
# SERVICE_NAME is optional and per-service: every service defaults to its canonical
# slug (auth-service, catalog-service, order-service, notification-worker,
# gateway-api). Override it only per service, never globally.

# -----------------------------------------------------------------------------
# auth-service
# -----------------------------------------------------------------------------
AUTH_DATABASE_URL=postgresql+asyncpg://kubecommerce:devpassword@postgres:5432/auth_db
# Preferred: path to a mounted/generated PEM key file.
# In Docker Compose / Kubernetes this path is mounted from a Secret. For bare
# local runs outside containers use the files created by scripts/dev-bootstrap.sh
# (AUTH_JWT_PRIVATE_KEY_FILE=.secrets/jwt-private.pem).
AUTH_JWT_PRIVATE_KEY_FILE=/secrets/jwt-private.pem
# Alternative: inline PEM (useful for local runs without a mounted secret).
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY_FILE=/secrets/jwt-public.pem
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_ISSUER=kubecommerce-auth
AUTH_JWT_AUDIENCE=kubecommerce
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# catalog-service
# -----------------------------------------------------------------------------
CATALOG_DATABASE_URL=postgresql+asyncpg://kubecommerce:devpassword@postgres:5432/catalog_db
CATALOG_REDIS_URL=redis://redis:6379/0
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_INTERNAL_API_TOKEN=dev-internal-token-change-me

# -----------------------------------------------------------------------------
# order-service
# -----------------------------------------------------------------------------
ORDERS_DATABASE_URL=postgresql+asyncpg://kubecommerce:devpassword@postgres:5432/orders_db
ORDERS_RABBITMQ_URL=amqp://kubecommerce:devpassword@rabbitmq:5672/
ORDERS_CATALOG_BASE_URL=http://catalog-service:8000
ORDERS_INTERNAL_API_TOKEN=dev-internal-token-change-me
ORDERS_REQUEST_TIMEOUT_SECONDS=5
ORDERS_OUTBOX_POLL_INTERVAL_SECONDS=2
ORDERS_OUTBOX_BATCH_SIZE=20

# -----------------------------------------------------------------------------
# notification-worker
# -----------------------------------------------------------------------------
WORKER_RABBITMQ_URL=amqp://kubecommerce:devpassword@rabbitmq:5672/
WORKER_REDIS_URL=redis://redis:6379/1
# Empty => log structured notification events instead of calling a webhook.
WORKER_WEBHOOK_URL=
WORKER_MAX_RETRIES=3
WORKER_PREFETCH=10
WORKER_DEDUPE_TTL_SECONDS=604800
WORKER_PROCESSING_TTL_SECONDS=60
WORKER_WEBHOOK_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# gateway-api
# -----------------------------------------------------------------------------
GATEWAY_REDIS_URL=redis://redis:6379/2
GATEWAY_AUTH_BASE_URL=http://auth-service:8000
GATEWAY_CATALOG_BASE_URL=http://catalog-service:8000
GATEWAY_ORDER_BASE_URL=http://order-service:8000
GATEWAY_JWKS_URL=http://auth-service:8000/.well-known/jwks.json
GATEWAY_JWT_ISSUER=kubecommerce-auth
GATEWAY_JWT_AUDIENCE=kubecommerce
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_REQUEST_TIMEOUT_SECONDS=5
GATEWAY_JWKS_CACHE_TTL_SECONDS=300
GATEWAY_DEPENDENCY_CHECK_INTERVAL_SECONDS=30
GATEWAY_INTERNAL_API_TOKEN=dev-internal-token-change-me

# -----------------------------------------------------------------------------
# Infrastructure / Docker Compose
# -----------------------------------------------------------------------------
POSTGRES_USER=kubecommerce
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=postgres
RABBITMQ_DEFAULT_USER=kubecommerce
RABBITMQ_DEFAULT_PASS=devpassword
COMPOSE_PROJECT_NAME=kubecommerce

# Image build / deploy coordinates (used by `make build` and Helm values).
IMAGE_REGISTRY=ghcr.io/your-github-username
IMAGE_TAG=dev
